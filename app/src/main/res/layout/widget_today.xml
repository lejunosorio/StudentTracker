<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget.

  Deliberately RemoteViews rather than Glance: the whole point of this app is that it costs a
  teacher nothing and works with the radio off, and a widget is not worth a Compose runtime on the
  launcher's process. The view set here is also the set every launcher has supported for a decade,
  so it renders the same on the cheap devices this app is actually used on.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:text="@string/widget_eyebrow_next" />

    <TextView
        android:id="@+id/widget_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_on_background"
        android:text="@string/widget_no_class" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_on_background_muted"
        android:text="@string/widget_no_class_detail" />

    <TextView
        android:id="@+id/widget_flags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/widget_on_background"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_action_attendance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_on_background"
            android:text="@string/widget_action_attendance" />

        <TextView
            android:id="@+id/widget_action_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_on_background"
            android:text="@string/widget_action_refresh" />
    </LinearLayout>
</LinearLayout>
