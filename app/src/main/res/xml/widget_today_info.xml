<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose. The launcher's own update cycle is capped at 30 minutes and
  would wake an encrypted database on a timer for a card nobody is looking at. Everything that
  already computes a digest - the Today screen, a reminder firing - pushes the result here instead,
  and the refresh button covers the rest.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
