<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. See backup_rules.xml for the reasoning; the same exclusions apply to both
    cloud backup and direct device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
